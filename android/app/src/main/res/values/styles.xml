<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <!-- Set the window only. android:background also paints selection popups and handles. -->
        <item name="android:windowBackground">@color/eccv_window_background</item>
        <item name="android:navigationBarColor">@color/eccv_window_background</item>
        <item name="android:windowLightNavigationBar">@bool/eccv_light_system_bars</item>
        <item name="android:statusBarColor">@color/eccv_window_background</item>
        <item name="android:windowLightStatusBar">@bool/eccv_light_system_bars</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:windowBackground">@drawable/splash</item>
    </style>
</resources>
